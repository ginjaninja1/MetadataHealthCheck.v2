<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SANDBOX-ONLY. Compiles the exact same source tree as
    ../MetadataHealthCheck.v2 (which targets netstandard2.0 with the real
    mediabrowser.server.core NuGet package plus Emby's own private
    SQLitePCL.pretty.dll/SQLitePCLRawEx.core.dll via HintPath) against net8.0
    + the local SQLitePCLPrettyShim, since this build sandbox has neither
    nuget.org access nor a real Emby-Server install to point a HintPath at.
    Not part of the shipped plugin. See Project Log.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../MetadataHealthCheck.v2/**/*.cs" Exclude="../MetadataHealthCheck.v2/obj/**/*.cs;../MetadataHealthCheck.v2/bin/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../SQLitePCLPrettyShim/SQLitePCLPrettyShim.csproj" />
  </ItemGroup>

</Project>